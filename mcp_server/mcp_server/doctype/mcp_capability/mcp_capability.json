{
  "doctype": "DocType",
  "name": "MCP Capability",
  "module": "Mcp Server",
  "engine": "InnoDB",
  "autoname": "field:title",
  "title_field": "title",
  "field_order": [
    "title",
    "enabled",
    "description",
    "allowed_roles",
    "plugin",
    "connector",
    "operation_id",
    "tool_name",
    "handler",
    "read_only",
    "supported",
    "method",
    "path",
    "content_type",
    "input_schema",
    "source_path"
  ],
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "الاسم",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "مفعّل",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "الوصف"
    },
    {
      "fieldname": "allowed_roles",
      "fieldtype": "Small Text",
      "label": "الأدوار المسموح لها",
      "description": "أسماء الأدوار، كل دور في سطر. فارغ = أدوار MCP الافتراضية."
    },
    {
      "fieldname": "plugin",
      "fieldtype": "Link",
      "label": "البلجن",
      "options": "MCP Plugin",
      "reqd": 1
    },
    {
      "fieldname": "connector",
      "fieldtype": "Link",
      "label": "الموصل",
      "options": "MCP Connector",
      "reqd": 1
    },
    {
      "fieldname": "operation_id",
      "fieldtype": "Data",
      "label": "معرف العملية",
      "reqd": 1
    },
    {
      "fieldname": "tool_name",
      "fieldtype": "Data",
      "label": "اسم أداة MCP",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "handler",
      "fieldtype": "Select",
      "label": "معالج العملية",
      "options": "Frappe\nHTTP\nRemote MCP\nAI\nBackup",
      "reqd": 1
    },
    {
      "fieldname": "read_only",
      "fieldtype": "Check",
      "label": "قراءة فقط",
      "default": "1"
    },
    {
      "fieldname": "supported",
      "fieldtype": "Check",
      "label": "يدعمها المعالج",
      "default": "1",
      "read_only": 1
    },
    {
      "fieldname": "method",
      "fieldtype": "Select",
      "label": "طريقة HTTP",
      "options": "\nGET\nPOST\nPUT\nPATCH\nDELETE\nHEAD"
    },
    {
      "fieldname": "path",
      "fieldtype": "Data",
      "label": "مسار العملية"
    },
    {
      "fieldname": "content_type",
      "fieldtype": "Select",
      "label": "نوع المحتوى",
      "options": "application/json\napplication/x-www-form-urlencoded\nmultipart/form-data\ntext/plain",
      "default": "application/json"
    },
    {
      "fieldname": "input_schema",
      "fieldtype": "Code",
      "label": "مخطط المدخلات",
      "options": "JSON",
      "reqd": 1
    },
    {
      "fieldname": "source_path",
      "fieldtype": "Small Text",
      "label": "المصدر",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "MCP Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "MCP Operator",
      "read": 1
    }
  ],
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC"
}