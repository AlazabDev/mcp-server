{
  "doctype": "DocType",
  "name": "MCP Plugin",
  "module": "Mcp Server",
  "engine": "InnoDB",
  "autoname": "field:title",
  "title_field": "title",
  "field_order": [
    "title",
    "enabled",
    "description",
    "allowed_roles",
    "plugin_id",
    "version",
    "manifest_json"
  ],
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "الاسم",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "مفعّل",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "الوصف"
    },
    {
      "fieldname": "allowed_roles",
      "fieldtype": "Small Text",
      "label": "الأدوار المسموح لها",
      "description": "أسماء الأدوار، كل دور في سطر. فارغ = أدوار MCP الافتراضية."
    },
    {
      "fieldname": "plugin_id",
      "fieldtype": "Data",
      "label": "معرف البلجن",
      "unique": 1,
      "reqd": 1
    },
    {
      "fieldname": "version",
      "fieldtype": "Data",
      "label": "الإصدار"
    },
    {
      "fieldname": "manifest_json",
      "fieldtype": "Code",
      "label": "بيانات البلجن",
      "options": "JSON"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "MCP Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "MCP Operator",
      "read": 1
    }
  ],
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC"
}