{
  "name": "@alazab/daftra-mcp",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Daftra MCP server with HTML dashboard, full API reference, and PM2 runtime",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && npm test",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 reload ecosystem.config.cjs --update-env",
    "pm2:logs": "pm2 logs alazab-daftra-mcp",
    "pm2:status": "pm2 status alazab-daftra-mcp"
  }
}