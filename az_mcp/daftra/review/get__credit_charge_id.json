{
  "path": "/credit_charge/{id}/1",
  "method": "get",
  "operation": {
    "summary": "Get Single Credit Charge",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns a single credit charge by id. A credit charge is an amount of a given credit type granted to a client (e.g. loyalty points, prepaid credit, or a membership allowance) that is later consumed.\n\nThis is a v2 native-entity endpoint served from the `/v2/api/entity` base and authenticated with a Bearer token. The trailing path segment (`1`) is the **data level** — how deeply related records are loaded — not a page number; on this endpoint it has no visible effect. The response is a flat credit-charge record.\n\nThe `status` value is one of:\n\n| Value | Meaning |\n|---|---|\n| `available` | Credit is available to consume |\n| `consumed` | Credit has been fully used |\n| `expired` | Credit passed its expiry date |\n| `suspended` | Credit is temporarily suspended |",
    "tags": [
      "Endpoints/Points & Credits/Credit Charges"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "The credit charge id.",
        "required": true,
        "schema": {
          "type": "integer"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "The credit charge record.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "Credit charge id."
                },
                "staff_id": {
                  "type": "integer",
                  "description": "Id of the staff member who added the charge. May be null.",
                  "nullable": true
                },
                "client_id": {
                  "type": "integer",
                  "description": "Id of the client the credit belongs to."
                },
                "credit_type_id": {
                  "type": "integer",
                  "description": "Id of the credit type."
                },
                "status": {
                  "type": "string",
                  "description": "Credit charge status.\n\n| Value | Meaning |\n|---|---|\n| available | Credit is available to consume |\n| consumed | Credit has been fully used |\n| expired | Credit passed its expiry date |\n| suspended | Credit is temporarily suspended |",
                  "enum": [
                    "available",
                    "consumed",
                    "expired",
                    "suspended"
                  ]
                },
                "start_date": {
                  "type": "string",
                  "description": "Start of the credit's validity window (`YYYY-MM-DD`)."
                },
                "expiry_date": {
                  "type": "string",
                  "description": "End of the validity window (`YYYY-MM-DD`), or null if it never expires.",
                  "nullable": true
                },
                "amount": {
                  "type": "number",
                  "description": "Credit amount granted."
                },
                "description": {
                  "type": "string",
                  "description": "Free-text note. May be null.",
                  "nullable": true
                },
                "created": {
                  "type": "string",
                  "description": "Creation timestamp (`YYYY-MM-DD HH:MM:SS`)."
                },
                "modified": {
                  "type": "string",
                  "description": "Last-modified timestamp (`YYYY-MM-DD HH:MM:SS`)."
                },
                "deleted_at": {
                  "type": "string",
                  "description": "Soft-delete timestamp, or null if not deleted.",
                  "nullable": true
                },
                "renewal_id": {
                  "type": "integer",
                  "description": "Id of the membership renewal that produced this charge, or null.",
                  "nullable": true
                }
              },
              "required": [
                "id",
                "staff_id",
                "client_id",
                "credit_type_id",
                "status",
                "start_date",
                "expiry_date",
                "amount",
                "description",
                "created",
                "modified",
                "deleted_at",
                "renewal_id"
              ]
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "The Bearer token is missing, invalid, or expired.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        },
        "headers": {}
      },
      "403": {
        "description": "The authenticated user lacks the Manage Credit Charges permission.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "get__credit_charge_id",
    "servers": [
      {
        "url": "https://entity-base.invalid/v2/api/entity"
      }
    ]
  },
  "blockers": []
}
