          "type": "string"
        }
      },
      {
        "name": "brand",
        "in": "query",
        "description": "Optional. Filters to brands whose name contains this text (case-insensitive substring match).",
        "required": false,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
