{
  "path": "/stores{format}",
  "method": "post",
  "operation": {
    "summary": "Add New Store",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Creates a new store (warehouse). Requires the *General Settings* permission. The request body wraps the fields in a `Store` object. Only `name` is required.\n\nSetting `primary` to `1` makes this the default store: it is forced to `active` and the primary flag is cleared on all other stores. Creation may be blocked by your plan's warehouse limit (see the `402` response).",
    "tags": [
      "Endpoints/Inventory /Stores",
      "Stores"
    ],
    "parameters": [
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "Store": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Name of the store. Required."
                  },
                  "shipping_address": {
                    "type": "string",
                    "description": "Shipping address of the store. Optional.",
                    "nullable": true
                  },
                  "primary": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Whether this store is the primary (default) store. Optional; defaults to `0`.\n\n| Value | Meaning |\n|---|---|\n| 0 | Not primary |\n| 1 | Primary |\n\nSetting `1` forces the store active and clears the primary flag on all other stores."
                  },
                  "active": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2
                    ],
                    "description": "Store status. Optional; defaults to `0` (Inactive) when omitted.\n\n| Value | Meaning |\n|---|---|\n| 0 | Inactive |\n| 1 | Active |\n| 2 | Suspended |"
                  },
                  "branch_id": {
                    "type": "integer",
                    "description": "Branch the store belongs to. Optional; defaults to the current branch."
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "Store"
            ]
          }
        }
      }
    },
    "responses": {
      "202": {
        "description": "Created",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "result": {
                  "type": "string"
                },
                "id": {
                  "type": "integer",
                  "description": "Id of the newly created store."
                }
              }
            }
          }
        },
        "headers": {}
      },
      "400": {
        "description": "Bad Request — validation failed (e.g. `name` missing).",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string",
                  "nullable": true
                },
                "validation_errors": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "402": {
        "description": "Payment Required — the plan's warehouse limit has been reached. This response uses a distinct envelope and does not include the `result` field.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "boolean"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                },
                "upgrade_url": {
                  "type": "string",
                  "description": "Link to upgrade the plan."
                },
                "upgrade_btn_title": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "403": {
        "description": "Forbidden — the user lacks the General Settings permission.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "post__stores_format"
  },
  "blockers": []
}
