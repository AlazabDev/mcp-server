{
  "path": "/sales_orders/{id}{format}",
  "method": "delete",
  "operation": {
    "summary": "Delete Sales Order",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Deletes a sales order identified by the `id` path parameter.\n\nRequires the Sales Order module to be enabled and permission to delete sales orders (a non-owner may delete only their own unless they hold the delete-all permission).\n\nA sales order **cannot** be deleted once it has been invoiced or partially invoiced, or while it is linked to a production plan — such requests are rejected with `400`. On success the response is `200` with a confirmation message.",
    "tags": [
      "Endpoints/Sales /Invoices",
      "Invoices"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "The sales order ID to delete.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format extension, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
