{
  "path": "/taxes/{id}{format}",
  "method": "put",
  "operation": {
    "summary": "Edit Taxes",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Updates an existing tax. Send the full set of editable fields; `name` and `value` are required. The same operation is also available via `POST /taxes/{id}`.",
    "tags": [
      "Endpoints/Taxes",
      "Taxes"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Identifier of the tax to update.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "Tax": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Display name of the tax (e.g. VAT). Required."
                  },
                  "value": {
                    "type": "number",
                    "description": "Tax rate as a percentage. Required; numeric (stored as a whole number)."
                  },
                  "description": {
                    "type": "string",
                    "description": "Optional free-text description of the tax."
                  },
                  "included": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 0,
                    "description": "Whether the tax is included in the product price.\n\n| Value | Meaning |\n|---|---|\n| 0 | Exclusive — the product price does not include the tax |\n| 1 | Inclusive — the product price already includes the tax |"
                  },
                  "is_active": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 1,
                    "description": "Whether the tax is active and selectable.\n\n| Value | Meaning |\n|---|---|\n| 0 | Inactive |\n| 1 | Active |"
                  }
                },
                "required": [
                  "name",
                  "value"
                ]
              }
            },
            "required": [
              "Tax"
            ]
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
