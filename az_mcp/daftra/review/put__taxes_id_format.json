                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string",
                  "nullable": true
                },
                "validation_errors": {
                  "type": "object",
                  "description": "Present on validation failure. Maps the offending field to its error message(s).",
                  "properties": {
                    "Attribute that caused the error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
