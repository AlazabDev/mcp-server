{
  "path": "/stores/{id}{format}",
  "method": "delete",
  "operation": {
    "summary": "Delete Stores",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Deletes a store (warehouse) by its id. Requires the *General Settings* permission.\n\nA store cannot be deleted if it is the primary store or if it has any stock transactions or open POS shifts — those cases return a `500` with an explanatory message. Such a store can be made inactive instead.",
    "tags": [
      "Endpoints/Inventory /Stores",
      "Stores"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Id of the store to delete.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "OK — the store was deleted.",
        "content": {
          "application/json": {
            "schema": {
