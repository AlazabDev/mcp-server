{
  "path": "/categories/update_category_items/{type}{format}",
  "method": "post",
  "operation": {
    "summary": "Update Category Items",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Sets which items (products) belong to one or more categories, in bulk.\n\nPath `{type}` is the item type (`1` for products). The request body is a JSON object mapping **each category ID to an ordered array of item IDs** — e.g. `{ \"12\": [101, 102] }`. For every category in the body the existing item assignments are **replaced** by the supplied list (the array order becomes the display order). All keys and values must be numeric.",
    "tags": [
      "Endpoints/Inventory /Product Categories",
      "Product Categories"
    ],
    "parameters": [
      {
        "name": "type",
        "in": "path",
        "description": "Item type. Use `1` for products.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix appended to the path. Use `.json` for JSON responses.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "description": "Map of category ID (key) to an ordered array of item IDs (value). All values must be numeric. Each listed category has its items replaced by the supplied list.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "properties": {}
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "description": "Category items updated. (The message text reads \"Display order updated\".)",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "400": {
        "description": "`type` is missing, or a body key/value is not numeric.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Missing or invalid access token.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
