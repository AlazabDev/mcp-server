{
  "path": "/products/{id}{format}",
  "method": "put",
  "operation": {
    "summary": "Edit Products",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Updates an existing product, service or bundle.\n\nThis is a partial update — send only the `Product` fields you want to change inside the `Product` object; omitted fields are left unchanged. No field is required.\n\nFor bundles, send the full set of components in `ProductBundle` to replace them; omit it to keep the existing components. Some changes are blocked once the product has stock movements — for example you cannot change the bundle type or the stock tracking type when related stock transactions exist. Products are scoped to the current branch. On success the response is a simple confirmation with HTTP 200.",
    "tags": [
      "Endpoints/Inventory /Products",
      "Products"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Unique identifier of the product to update.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix appended to the path. Use `.json` for JSON responses.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "Product": {
                "type": "object",
                "description": "Product fields to change. Send only the fields you want to update.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Product name."
                  },
                  "type": {
                    "type": "integer",
                    "enum": [
                      1,
                      2,
                      3
                    ],
                    "description": "Product type.\n\n| Value | Meaning |\n|---|---|\n| 1 | Product |\n| 2 | Service |\n| 3 | Bundle |"
                  },
                  "product_code": {
                    "type": "string",
                    "description": "Product code."
                  },
                  "barcode": {
                    "type": "string",
                    "description": "Barcode. When provided it must be unique and at least 5 characters long."
                  },
                  "description": {
                    "type": "string",
                    "description": "Product description (up to 100,000 characters)."
                  },
                  "notes": {
                    "type": "string",
                    "description": "Internal notes."
                  },
                  "unit_price": {
                    "type": "number",
                    "description": "Selling price of one unit."
                  },
                  "buy_price": {
                    "type": "number",
                    "description": "Purchase (cost) price."
                  },
                  "minimum_price": {
                    "type": "number",
                    "description": "Minimum selling price."
                  },
                  "profit_margin": {
                    "type": "number",
                    "description": "Profit margin."
                  },
                  "discount": {
                    "type": "number",
                    "description": "Discount amount."
                  },
                  "discount_type": {
                    "type": "integer",
                    "enum": [
                      1,
                      2
                    ],
                    "description": "Discount type.\n\n| Value | Meaning |\n|---|---|\n| 1 | Percentage |\n| 2 | Absolute |"
                  },
                  "tax1": {
                    "type": "integer",
                    "description": "First tax ID."
                  },
                  "tax2": {
                    "type": "integer",
                    "description": "Second tax ID."
                  },
                  "supplier_id": {
                    "type": "integer",
                    "description": "Default supplier ID."
                  },
                  "brand": {
                    "type": "string",
                    "description": "Brand name. Created automatically if it does not yet exist."
                  },
                  "category": {
                    "type": "string",
                    "description": "Single category name. Prefer `categories_id` for the API."
                  },
                  "categories_id": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Category IDs to assign to the product."
                  },
                  "tags": {
                    "type": "string",
                    "description": "Tags as a comma-separated string (or an array of strings)."
                  },
                  "status": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2
                    ],
                    "description": "Product status.\n\n| Value | Meaning |\n|---|---|\n| 0 | Active |\n| 1 | Inactive |\n| 2 | Suspended |"
                  },
                  "track_stock": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Whether to track stock for this product. Requires the Inventory feature."
                  },
                  "tracking_type": {
                    "type": "integer",
                    "description": "Stock tracking type. Cannot be changed once the product has related stock transactions (unless negative tracking is allowed)."
                  },
                  "initial_stock_level": {
                    "type": "number",
                    "description": "Opening stock quantity. Applied when `track_stock` is `1` and a `store_id` is provided."
                  },
                  "store_id": {
                    "type": "integer",
                    "description": "Warehouse for the opening stock. Must be an active store."
                  },
                  "low_stock_thershold": {
                    "type": "integer",
                    "description": "Threshold at which a low-stock notification is raised."
                  },
                  "duration_minutes": {
                    "type": "number",
                    "description": "Service duration in minutes (services only)."
                  },
                  "availabe_online": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Whether the product is available online (`1`) or not (`0`)."
                  }
                }
              },
              "ProductBundle": {
                "type": "array",
                "description": "Bundle components (for `type = 3`). Sending this replaces the existing components; omit it to keep them.",
                "items": {
                  "type": "object",
                  "required": [
                    "product_id",
                    "quantity"
                  ],
                  "properties": {
                    "product_id": {
                      "type": "integer",
                      "description": "ID of a product included in the bundle. Cannot be the bundle's own ID."
                    },
                    "quantity": {
                      "type": "number",
                      "description": "Quantity of that product in the bundle."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "description": "Product updated. The response is a confirmation; product data is not echoed.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string",
                  "description": "Optional informational message."
                }
              }
            }
          }
        },
        "headers": {}
      },
      "400": {
        "description": "Validation failed, or the change is not allowed: changing the bundle type or the stock tracking type when related stock transactions exist, or including the bundle itself as one of its own components.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string",
                  "nullable": true
                },
                "validation_errors": {
                  "type": "object",
                  "description": "Field-level validation messages, keyed by field name.",
                  "properties": {}
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Missing or invalid access token.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "403": {
        "description": "The authenticated user lacks permission to edit this product.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "404": {
        "description": "No product matches the given ID, or the product belongs to another branch and is not shared with the current branch.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "put__products_id_format"
  },
  "blockers": []
}
