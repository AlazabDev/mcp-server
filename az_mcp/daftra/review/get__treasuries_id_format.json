{
  "path": "/treasuries/{id}{format}",
  "method": "get",
  "operation": {
    "summary": "GET Single Treasury",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns a single treasury or bank account by id. Requires one of the treasury-related permissions (assigned-treasury view, change default treasury, view all journals, manage journal accounts) or the *General Settings* permission; staff additionally must hold a withdraw or deposit permission on the requested treasury.",
    "tags": [
      "Endpoints/Finance/Treasuries",
      "Treasuries"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Identifier of the treasury to retrieve.",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "result": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "Treasury": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Unique identifier of the treasury.",
                          "readOnly": true
                        },
                        "staff_id": {
                          "type": "integer",
                          "description": "Owner staff id, or `0` for the account owner."
                        },
                        "name": {
                          "type": "string",
                          "maxLength": 255,
                          "description": "Name of the treasury or bank account."
                        },
                        "type": {
                          "type": "integer",
                          "enum": [
                            1,
                            2,
                            3
                          ],
                          "description": "Kind of account.\n\n| Value | Meaning |\n|---|---|\n| 1 | Bank account |\n| 2 | Personal (legacy) |\n| 3 | Treasury (cash) |"
                        },
                        "type_name": {
                          "type": "string",
                          "description": "Bank/account label (used for bank accounts).",
                          "nullable": true
                        },
                        "type_account_number": {
                          "type": "string",
                          "description": "Bank account number (used for bank accounts).",
                          "nullable": true
                        },
                        "active": {
                          "type": "integer",
                          "enum": [
                            0,
                            1
                          ],
                          "description": "Whether the treasury is active.\n\n| Value | Meaning |\n|---|---|\n| 0 | Inactive |\n| 1 | Active |"
                        },
                        "is_primary": {
                          "type": "integer",
                          "enum": [
                            0,
                            1
                          ],
                          "description": "Whether this is the primary (default) treasury.\n\n| Value | Meaning |\n|---|---|\n| 0 | Not primary |\n| 1 | Primary |"
                        },
                        "description": {
                          "type": "string",
                          "description": "Free-text description."
                        },
                        "currency_code": {
                          "type": "string",
                          "maxLength": 3,
                          "description": "ISO currency code (set for bank accounts; treasuries default to the account currency).",
                          "nullable": true
                        },
                        "metainfo": {
                          "type": "object",
                          "description": "Bank reconciliation metadata (bank accounts only), returned as a decoded object.",
                          "properties": {},
                          "nullable": true
                        },
                        "created": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the treasury was created.",
                          "readOnly": true
                        },
                        "modified": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the treasury was last updated.",
                          "readOnly": true
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Unauthorized — missing or invalid access token.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "403": {
        "description": "Forbidden — the user lacks a treasury-related permission and General Settings.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "404": {
        "description": "Not found — no treasury with this id is accessible to the user.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "get__treasuries_id_format"
  },
  "blockers": []
}
