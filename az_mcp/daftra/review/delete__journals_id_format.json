{
  "path": "/journals/{id}{format}",
  "method": "delete",
  "operation": {
    "summary": "Delete Journals",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Deletes a journal entry. Automatically-generated journals linked to a source record, and journals dated inside a closed financial period, cannot be deleted.",
