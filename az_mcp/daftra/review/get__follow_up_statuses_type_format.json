{
  "path": "/follow_up_statuses/{type}{format}",
  "method": "get",
  "operation": {
    "summary": "Get All Follow-Up Statuses by type",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns every follow-up status defined for a given item type — the stages a record (client, invoice, work order, …) can move through. Requires the **Edit Client Settings** permission. Statuses are returned in their configured display order.\n\nThe `{type}` path segment selects which item type's statuses to return and must be one of the supported values:\n\n| Value | Item type |\n|---|---|\n| `client` | Clients |\n| `invoice` | Invoices |\n| `estimate` | Estimates |\n| `purchase_order` | Purchase orders |\n| `staff` | Staff |\n| `supplier` | Suppliers |\n| `product` | Products |\n| `work_order` | Work orders |\n\nAny other value returns `404`.",
    "tags": [
      "Endpoints/Sales /Follow-Up Status",
      "Follow Up Statuses"
    ],
    "parameters": [
      {
        "name": "type",
        "in": "path",
        "description": "The item type whose follow-up statuses to return.\n\n| Value | Item type |\n|---|---|\n| `client` | Clients |\n| `invoice` | Invoices |\n| `estimate` | Estimates |\n| `purchase_order` | Purchase orders |\n| `staff` | Staff |\n| `supplier` | Suppliers |\n| `product` | Products |\n| `work_order` | Work orders |",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "page",
        "in": "query",
        "description": "Page number for the paginated result. Defaults to `1`.",
        "required": false,
        "schema": {
          "type": "integer"
        }
      }
    ],
    "responses": {
