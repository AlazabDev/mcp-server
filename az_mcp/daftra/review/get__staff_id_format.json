                          "description": "Staff's City"
                        },
                        "state": {
                          "type": "string",
                          "maxLength": 100,
                          "description": "Staff's State"
                        },
                        "postal_code": {
                          "type": "string",
                          "maxLength": 20,
                          "description": "Staff's postal code"
                        },
                        "notes": {
                          "type": "string",
