                          "description": "Time of creation for the Staff",
                          "readOnly": true
                        },
                        "follow_up_status": {
                          "type": "integer",
                          "description": "Follow Up Status get it from [GET Follow up statuses with model staff](/15115383e0)",
                          "default": null,
                          "nullable": true
