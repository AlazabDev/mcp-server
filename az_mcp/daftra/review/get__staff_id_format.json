                        },
                        "email_address": {
                          "type": "string",
                          "format": "email",
                          "maxLength": 255,
                          "description": "Staff's email"
                        },
                        "last_login": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time of the lsat successful login for the Staff",
