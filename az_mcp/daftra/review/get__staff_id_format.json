{
  "path": "/staff/{id}{format}",
  "method": "get",
  "operation": {
    "summary": "GET Single Staff",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Retrieves a single staff member by id. The staff record is returned under a `Staff` key inside `data`; the password is never included. Any configured custom staff fields appear under the nested `CustomModel` object.\n\nAuthenticate with a Bearer access token (or the legacy `apikey` header). A request without valid credentials returns `401`; a session user without staff-management permission returns `403`.",
    "tags": [
      "Endpoints/Staff",
      "Staff"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "The staff member's unique id.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Optional response-format suffix appended to the path, e.g. `.json`. Leave empty to receive the default JSON response.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
