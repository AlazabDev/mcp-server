{
  "path": "/journals/{id}{format}",
  "method": "get",
  "operation": {
    "summary": "GET Single Journal",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns a single journal entry with its double-entry transaction lines.",
    "tags": [
      "Endpoints/Accounting/Journals",
      "Journals"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Journal id.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "Journal": {
                      "type": "object",
                      "description": "The full journal row. Key fields are listed below; additional stored columns may also be present.",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "Unique identifier"
                        },
                        "number": {
                          "type": "string",
                          "description": "Journal number"
                        },
                        "date": {
                          "type": "string",
                          "format": "date",
                          "description": "Journal date"
                        },
                        "description": {
                          "type": "string",
                          "description": "Journal description"
                        },
                        "alter_description": {
                          "type": "string",
                          "description": "Alternate description",
                          "nullable": true
                        },
                        "entity_type": {
                          "type": "string",
                          "description": "Source type that generated the journal; empty for manual journals",
                          "nullable": true
                        },
                        "entity_id": {
                          "type": "string",
                          "description": "Id of the source record",
                          "nullable": true
                        },
                        "draft": {
                          "type": "integer",
                          "description": "0 = issued, 1 = draft"
                        },
                        "is_automatic": {
                          "type": "integer",
                          "description": "1 when the journal was generated automatically"
                        },
                        "staff_id": {
                          "type": "integer",
                          "description": "Staff id who created the journal; `0` means the account owner"
                        },
                        "total_debit": {
                          "type": "number",
                          "description": "Total debit (base currency), always equal to total credit"
                        },
                        "total_credit": {
                          "type": "number",
                          "description": "Total credit (base currency), always equal to total debit"
                        },
                        "currency_code": {
                          "type": "string",
                          "description": "Journal currency code"
                        },
                        "currency_rate": {
                          "type": "number",
                          "description": "Currency conversion rate applied to the journal"
                        },
                        "local_currency_code": {
                          "type": "string",
                          "description": "The account's default (base) currency code"
                        },
                        "show_loacal_currency": {
                          "type": "boolean",
                          "description": "Present and `true` only when the journal currency differs from the base currency. (The key spelling `loacal` matches the API response.)"
                        },
                        "created": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Creation timestamp"
                        },
                        "modified": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Last update timestamp"
                        },
                        "JournalTransaction": {
                          "type": "array",
                          "description": "The double-entry transaction lines of this journal.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "description": "Unique identifier"
                              },
                              "journal_id": {
                                "type": "string",
                                "description": "Parent journal id"
                              },
                              "journal_account_id": {
                                "type": "string",
                                "description": "Journal account id for this line"
                              },
                              "debit": {
                                "type": "number",
                                "description": "Debit amount (base currency)"
                              },
                              "credit": {
                                "type": "number",
                                "description": "Credit amount (base currency)"
                              },
                              "currency_debit": {
                                "type": "number",
                                "description": "Debit amount in the journal currency"
                              },
                              "currency_credit": {
                                "type": "number",
                                "description": "Credit amount in the journal currency"
                              },
                              "description": {
                                "type": "string",
                                "description": "Line description",
                                "nullable": true
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
