{
  "path": "/invoice_appointments{format}",
  "method": "post",
  "operation": {
    "summary": "Add New Invoice Appointment",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Creates an invoice appointment (a follow-up appointment attached to an invoice). The appointment fields are wrapped in an `InvoiceAppointments` object; `item_id` (the invoice id) and `date` are required. Optionally include a `RecurringAppointment` object (with `recurring` set to `1`) to create a repeating appointment. Requires permission to add appointments/notes. Returns `202` with the new appointment's `id`.",
    "tags": [
      "Endpoints/Sales /Invoice Appointments",
      "Invoice Appointments"
    ],
    "parameters": [
      {
        "name": "format",
        "in": "path",
        "description": "",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "InvoiceAppointments": {
                "type": "object",
                "properties": {
                  "item_id": {
                    "type": "integer",
                    "description": "The invoice id to attach the appointment to. **Required.**"
                  },
                  "date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Appointment start date/time. **Required.** Must be earlier than `end_date`."
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Appointment end date/time. Optional; computed from `duration` when omitted."
                  },
                  "duration": {
                    "type": "string",
                    "description": "Appointment length in hours (numeric) or as `HH:MM`. Optional; defaults to 1 hour and is used to compute `end_date` when `end_date` is not supplied."
                  },
                  "action_id": {
                    "type": "integer",
                    "description": "Follow-up action id."
                  },
                  "staff_id": {
                    "description": "Id of the creating staff member, or an array of staff ids to assign. Defaults to the authenticated staff when omitted."
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 1500,
                    "description": "Free-text note (max 1500 characters)."
                  },
                  "status": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2
                    ],
                    "default": 0,
                    "description": "On creation the status is set to `0` (Scheduled) automatically."
                  },
                  "recurring": {
                    "type": "boolean",
                    "default": false,
                    "description": "Set to `1` to create a repeating appointment; supply the recurrence in the `RecurringAppointment` object."
                  },
                  "share_with_partner": {
                    "type": "boolean",
                    "description": "Share the appointment with the linked partner (the invoice's client)."
                  }
                },
                "required": [
                  "item_id",
                  "date"
                ]
              },
              "RecurringAppointment": {
                "type": "object",
                "description": "Recurrence settings; used when `recurring` is `1`.",
                "properties": {
                  "period_unit": {
                    "type": "integer",
                    "description": "Repeat interval (number of `unit_name` units between occurrences)."
                  },
                  "unit_count": {
                    "type": "integer",
                    "description": "How many occurrences to generate."
                  },
                  "unit_name": {
                    "type": "string",
                    "description": "Recurrence unit, e.g. `day`, `week`, `month`."
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Date to stop generating occurrences."
                  }
                },
                "additionalProperties": true
              }
            },
            "required": [
              "InvoiceAppointments"
            ]
          }
        }
      }
    },
    "responses": {
      "202": {
        "description": "The appointment was created.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "id": {
                  "type": "integer",
                  "format": "int64",
                  "description": "The new appointment's identifier."
                }
              }
            }
          }
        },
        "headers": {}
      },
      "400": {
        "description": "Validation failed; `validation_errors` lists the offending fields.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                },
                "validation_errors": {
                  "type": "object",
                  "properties": {
                    "Attribute that caused the error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "403": {
        "description": "The caller lacks permission for this operation.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "404": {
        "description": "The referenced invoice does not exist (or belongs to a suspended client).",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "post__invoice_appointments_format"
  },
  "blockers": []
}
