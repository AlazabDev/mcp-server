                            "description": "Client gender.\n\n| Value | Meaning |\n|---|---|\n| 0 | Not selected |\n| 1 | Male |\n| 2 | Female |"
                          },
                          "birth_date": {
                            "type": "string",
                            "format": "date",
                            "description": "Client's date of birth."
                          },
                          "photo": {
                            "type": "string",
                            "description": "Path to the client's photo."
                          },
                          "map_location": {
                            "type": "string",
                            "description": "Geographic map location."
                          },
                          "link": {
                            "type": "string",
                            "maxLength": 255,
                            "description": "Client website / external link."
                          },
                          "bn1": {
                            "type": "string",
                            "description": "Custom business field 1 value."
                          },
                          "bn1_label": {
                            "type": "string",
                            "description": "Custom business field 1 label."
                          },
                          "bn2": {
                            "type": "string",
                            "description": "Custom business field 2 value."
                          },
                          "bn2_label": {
                            "type": "string",
                            "description": "Custom business field 2 label."
                          },
                          "suspend": {
                            "type": "boolean",
                            "description": "Whether the client is suspended (blocked from portal login). `0` / `1`."
                          },
                          "last_login": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Last portal login time."
                          },
                          "last_ip": {
                            "type": "string",
                            "description": "Last login IP address."
                          },
                          "original_site_id": {
                            "type": "integer",
                            "description": "Originating account identifier (for cloned/migrated clients)."
                          },
                          "created": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Time the client record was created."
                          },
                          "modified": {
                            "type": "string",
                            "format": "date-time",
