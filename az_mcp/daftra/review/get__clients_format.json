{
  "path": "/clients{format}",
  "method": "get",
  "operation": {
    "summary": "GET All Clients",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns a paginated list of clients for the account.\n\nSupports keyword search and filtering by assigned staff, plus standard pagination. Each item is wrapped in a `Client` object. Requires a permission that grants access to clients (viewing all clients, or viewing the staff member's own assigned clients).",
    "tags": [
      "Endpoints/Clients /Clients",
      "Clients"
    ],
    "parameters": [
      {
        "name": "format",
        "in": "path",
        "description": "",
        "required": true,
        "schema": {
          "type": "integer",
          "default": 1
        }
      },
      {
        "name": "keywords",
        "in": "query",
        "description": "Search clients by ID, client number, business name, first/last name, email or phone. (National ID is also searched when that setting is enabled.)",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "assign_staff_id",
        "in": "query",
        "description": "Return only clients assigned to the given staff member.",
        "required": false,
        "schema": {
          "type": "integer"
        }
      },
      {
        "name": "limit",
        "in": "query",
        "description": "The collection items limit",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 20
        }
      },
      {
        "name": "page",
        "in": "query",
        "description": "The collection items page",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    ],
