                            "type": "string",
                            "description": "Human-facing client code / reference."
                          },
                          "site_id": {
                            "type": "integer",
                            "description": "Identifier of the account (site) the client belongs to."
                          },
                          "staff_id": {
                            "type": "integer",
                            "default": 0,
                            "description": "Staff member who owns/created the client. `0` means the account owner."
                          },
                          "is_offline": {
                            "type": "boolean",
                            "description": "Whether the client originates from offline (e.g. POS) rather than online sign-up. `0` / `1`."
                          },
                          "business_name": {
                            "type": "string",
                            "maxLength": 100,
                            "description": "Client's business (company) name."
                          },
                          "first_name": {
                            "type": "string",
                            "maxLength": 255,
                            "description": "Client's first name (individual clients)."
                          },
                          "last_name": {
                            "type": "string",
                            "maxLength": 255,
                            "description": "Client's last name (individual clients)."
                          },
                          "email": {
                            "type": "string",
                            "format": "email",
                            "maxLength": 255,
                            "description": "Client's email address."
                          },
                          "type": {
                            "type": "integer",
                            "enum": [
                              2,
                              3
                            ],
                            "description": "Client type.\n\n| Value | Meaning |\n|---|---|\n| 2 | Individual |\n| 3 | Business |"
                          },
