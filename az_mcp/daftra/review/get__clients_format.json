                          "credit_period": {
                            "type": "integer",
                            "default": 0,
                            "description": "Allowed credit period, in days."
                          },
                          "timezone": {
                            "type": "integer",
                            "default": 0,
                            "description": "Client timezone identifier."
                          },
                          "branch_id": {
                            "type": "integer",
                            "default": 1,
                            "description": "Branch the client is scoped to."
                          },
                          "gender": {
                            "type": "integer",
                            "enum": [
                              0,
                              1,
                              2
