                            "maxLength": 255,
                            "description": "Secondary contact name."
                          },
                          "secondary_address1": {
                            "type": "string",
                            "maxLength": 255,
                            "description": "Secondary address line 1."
                          },
                          "secondary_address2": {
                            "type": "string",
                            "maxLength": 255,
