              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string",
                  "description": "Set for the closed-work-order precondition (e.g. \"Work Order is closed, you can't edit\"); `null` on validation failures, where the detail is in `validation_errors`.",
                  "nullable": true
                },
                "validation_errors": {
                  "type": "object",
                  "description": "Field name → reason. Present when validation fails.",
                  "properties": {
                    "title": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
