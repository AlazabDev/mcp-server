{
  "path": "/estimates/{id}{format}",
  "method": "delete",
  "operation": {
    "summary": "Delete Estimate",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Deletes an estimate identified by the `id` path parameter.\n\nRequires permission to delete estimates (a non-owner may delete only estimates they created unless they hold the delete-all permission). One estimate is deleted per call.\n\nAn estimate that has already been **converted to an invoice or to a sales order cannot be deleted** — such requests are rejected (HTTP `401`, see the response below). On success the response is `200` with a confirmation message.",
    "tags": [
      "Endpoints/Sales /Estimates",
      "Estimates"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "The estimate ID to delete.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format extension, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
