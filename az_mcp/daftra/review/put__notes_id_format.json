{
  "path": "/notes/{id}{format}",
  "method": "put",
  "operation": {
    "summary": "Edit Notes",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Updates an existing note identified by `{id}`. The note's record (`item_type` / `item_id`) and author are fixed by the stored note and cannot be changed; values sent for them in the body are ignored. The request body is wrapped in a `Note` object.",
    "tags": [
      "Endpoints/Clients /Notes",
      "Notes"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Identifier of the note to update.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "Note": {
                "type": "object",
                "description": "The note fields to update.",
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date of the note. Required."
                  },
                  "body": {
                    "type": "string",
                    "description": "Note text. May contain HTML."
                  },
                  "status_id": {
                    "type": "integer",
                    "description": "Optional follow-up status to apply."
                  },
                  "action_id": {
                    "type": "integer",
                    "description": "Optional follow-up action."
                  },
                  "share_with_partner": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Share the note with the client.\n\n| Value | Meaning |\n|---|---|\n| 0 | Private |\n| 1 | Shared with client |"
                  },
                  "attachments": {
                    "type": "string",
                    "description": "Comma-separated list of previously uploaded file ids to attach to the note."
                  }
                },
                "required": [
                  "date"
                ]
              }
            },
            "required": [
              "Note"
            ]
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "description": "OK — the note was updated.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "400": {
        "description": "Bad Request — the note failed validation.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                },
                "validation_errors": {
                  "type": "object",
                  "description": "Field-level validation errors, when present.",
                  "properties": {},
                  "nullable": true
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Unauthorized — missing or invalid access token.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "403": {
        "description": "Forbidden — the user lacks permission to edit this note.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "404": {
        "description": "Not Found — no note exists with the given id.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "put__notes_id_format"
  },
  "blockers": []
}
