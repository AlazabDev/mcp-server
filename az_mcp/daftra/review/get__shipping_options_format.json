{
  "path": "/shipping_options{format}",
  "method": "get",
  "operation": {
    "summary": "List Shipping Options",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns the account's **active** shipping options — the named delivery methods (each with a fee and an optional tax) that can be applied to invoices.\n\nNotes:\n\n- Only active shipping options are returned; disabled or removed ones are omitted.\n- This endpoint is **not paginated** — every active shipping option is returned in a single `data` array, and `page` / `limit` query parameters are ignored.\n- It takes no query parameters and no request body.\n- Each item exposes `tax_id` as a plain identifier; the related tax record is not embedded.\n\nRequires a valid bearer token; no additional permission is needed.",
    "tags": [
      "Endpoints/Sales /Shipping Options",
      "Shipping Options"
    ],
    "parameters": [
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "List of active shipping options.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "data": {
                  "type": "array",
                  "description": "All active shipping options. This list is not paginated.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ShippingOption": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "format": "int64",
                            "description": "Unique identifier of the shipping option.",
                            "readOnly": true
                          },
                          "name": {
                            "type": "string",
                            "maxLength": 255,
                            "description": "Display name of the shipping option (the delivery method shown to clients)."
                          },
                          "fees": {
                            "type": "string",
                            "description": "Shipping fee charged for this option, returned as a decimal string."
                          },
                          "tax_id": {
                            "type": "integer",
                            "description": "Identifier of the tax applied to this option's fee, or `null` when no tax applies. The tax record itself is not embedded.",
                            "nullable": true
                          },
                          "display_order": {
                            "type": "integer",
                            "description": "Position used when ordering shipping options for display.",
                            "nullable": true
                          },
                          "status": {
                            "type": "integer",
                            "enum": [
                              0,
                              1
                            ],
                            "description": "Whether the shipping option is active. Only active options are returned by this endpoint.\n\n| Value | Meaning |\n|---|---|\n| 0 | Inactive |\n| 1 | Active |"
                          },
                          "description": {
                            "type": "string",
                            "description": "Optional free-text description of the shipping option.",
                            "default": null,
                            "nullable": true
                          },
                          "created": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Time the shipping option was created.",
                            "readOnly": true
                          },
                          "modified": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Time the shipping option was last updated.",
                            "readOnly": true
                          },
                          "deleted_at": {
                            "type": "string",
                            "description": "Soft-delete timestamp. Always `null` for options returned by this endpoint.",
                            "nullable": true
                          },
                          "account_id": {
                            "type": "integer",
                            "description": "Internal account association, when set.",
                            "nullable": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Missing or invalid bearer token.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "403": {
        "description": "The account's subscription has expired.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "get__shipping_options_format"
  },
  "blockers": []
}
