        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "supplier_id",
        "in": "query",
        "description": "Filter by supplier id.",
        "required": false,
        "schema": {
          "type": "integer"
        }
      },
      {
        "name": "payment_status",
        "in": "query",
        "description": "Filter by payment status. Omit to return all non-draft refunds.\n\n| Value | Meaning |\n|---|---|\n| -1 | Draft refunds only |\n| 0 | Unpaid |\n| 1 | Partially paid |\n| 2 | Paid |\n| 3 | Refunded |\n| 4 | Over-paid |",
        "required": false,
        "schema": {
          "type": "integer"
        }
      },
      {
        "name": "no",
        "in": "query",
        "description": "Filter by the refund number.",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "currency_code",
        "in": "query",
