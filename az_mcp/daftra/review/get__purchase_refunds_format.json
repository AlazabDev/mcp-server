        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "date_from",
        "in": "query",
        "description": "Filter by refund date, inclusive lower bound. Uses the account date format.",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "date_to",
        "in": "query",
        "description": "Filter by refund date, inclusive upper bound. Uses the account date format.",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "summary_total_from",
        "in": "query",
        "description": "Filter by total amount, lower bound.",
        "required": false,
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "summary_total_to",
        "in": "query",
        "description": "Filter by total amount, upper bound.",
        "required": false,
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "item",
        "in": "query",
        "description": "Return only refunds that contain a line item matching this text (searches the item name, description, and the additional item columns).",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "work_order_id",
        "in": "query",
        "description": "Filter by the linked work order id.",
        "required": false,
        "schema": {
          "type": "integer"
        }
      },
      {
        "name": "staff_id",
        "in": "query",
        "description": "Filter by the staff member who created the refund. Available when the Staff plugin is active and the caller can view all purchase orders.",
        "required": false,
        "schema": {
          "type": "integer"
        }
      }
    ],
