{
  "path": "/purchase_refunds{format}",
  "method": "get",
  "operation": {
    "summary": "GET All Purchase Refunds",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns a paginated list of purchase refunds (purchase debit notes), most recent first. Supports free-text search and filtering by supplier, payment status, refund number, currency, date range, total range, line item, work order, and the staff member who created the refund.",
    "tags": [
      "Endpoints/Purchases/Purchase Refunds",
      "Purchase Refunds"
    ],
    "parameters": [
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "limit",
        "in": "query",
        "description": "The collection items limit.",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 20
        }
      },
      {
        "name": "page",
        "in": "query",
        "description": "The collection items page.",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      {
        "name": "keywords",
