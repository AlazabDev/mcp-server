{
  "path": "/purchase_orders/{id}{format}",
  "method": "get",
  "operation": {
    "summary": "GET Single Purchase Order",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns a single purchase order as JSON, identified by its id. Only records of type Purchase Order are returned by this endpoint.\n\nThe purchase order's line items, supplier, creating staff member, custom fields, attachments, taxes and payments are nested **inside** the `data.PurchaseOrder` object (e.g. `data.PurchaseOrder.PurchaseOrderItem`). The `password` field is omitted from the nested `Supplier` and `Staff` objects.",
    "tags": [
      "Endpoints/Purchases/Purchase Orders",
      "Purchase Orders"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "The purchase order id.",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
