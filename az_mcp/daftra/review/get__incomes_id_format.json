                          "type": "number",
                          "description": "Income amount (before taxes)."
                        },
                        "currency_code": {
                          "type": "string",
                          "description": "3-letter ISO 4217 currency code."
                        },
                        "vendor": {
                          "type": "string",
                          "description": "Vendor name. May be empty."
                        },
                        "category": {
                          "type": "string",
                          "description": "Category name. May be empty."
                        },
                        "date": {
                          "type": "string",
                          "description": "Date of the income (YYYY-MM-DD)."
                        },
                        "file": {
                          "type": "string",
                          "description": "Legacy single-file attachment reference. May be empty."
                        },
                        "note": {
                          "type": "string",
