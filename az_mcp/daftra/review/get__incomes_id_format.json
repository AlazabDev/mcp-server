                        },
                        "expense_number": {
                          "type": "string",
                          "description": "Income number / reference code."
                        },
                        "accounts_data": {
                          "type": "string",
                          "description": "Per-line account allocation, as a JSON-encoded string. Populated for draft records."
                        },
                        "external_source": {
                          "type": "string",
                          "description": "Origin of the record (e.g. `web`, `mobile`)."
                        },
                        "last_update_external_source": {
                          "type": "string",
                          "description": "Origin of the last update (e.g. `web`, `mobile`)."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "draft",
                            "issued"
                          ],
                          "description": "Record status.\n\n| Value | Meaning |\n|---|---|\n| issued | Issued (posted) |\n| draft | Draft |"
                        },
                        "extra_details": {
                          "type": "string",
                          "description": "Additional processing metadata, as a JSON-encoded string."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
