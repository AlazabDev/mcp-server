{
  "path": "/incomes/{id}{format}",
  "method": "get",
  "operation": {
    "summary": "GET Single Income",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Retrieve a single income by id.\n\nReturns the income wrapped in an `Income` object under `data`.\n\n**Access:** available to the account owner, or to staff holding any of the *View His Own Incomes*, *Add New Incomes*, or *Edit/Delete His Own Incomes* permissions. Staff without *View All Incomes* or *Edit/Delete All Incomes* can only read incomes they recorded.",
    "tags": [
      "Endpoints/Finance/Incomes",
      "Incomes"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Reference of the income to retrieve.",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix appended to the path, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
