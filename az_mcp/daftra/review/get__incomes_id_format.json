                        },
                        "tax1_name": {
                          "type": "string",
                          "description": "First tax name."
                        },
                        "tax1_value": {
                          "type": "number",
                          "description": "First tax rate (percentage)."
                        },
                        "tax1_amount": {
                          "type": "number",
