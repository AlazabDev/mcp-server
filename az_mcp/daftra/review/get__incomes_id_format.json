                          "type": "string",
                          "description": "Type of the originating record, when generated from another entity. May be null."
                        },
                        "expense_category_id": {
                          "type": "integer",
                          "description": "Reference of the income category; `0` if uncategorised."
                        },
                        "journal_account_id": {
                          "type": "integer",
                          "description": "Journal (chart-of-accounts) account reference. May be null."
                        },
                        "branch_id": {
                          "type": "integer",
