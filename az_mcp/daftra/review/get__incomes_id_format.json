                        },
                        "tax2_id": {
                          "type": "integer",
                          "description": "Second tax reference. May be null."
                        },
                        "tax2_name": {
                          "type": "string",
                          "description": "Second tax name."
                        },
                        "tax2_value": {
                          "type": "number",
                          "description": "Second tax rate (percentage)."
                        },
                        "tax2_amount": {
