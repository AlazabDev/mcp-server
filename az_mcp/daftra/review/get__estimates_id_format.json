                },
                "data": {
                  "type": "object",
                  "description": "The estimate, with full nested detail.",
                  "properties": {
                    "Estimate": {
                      "type": "object",
                      "description": "The estimate header plus its nested line items, payments, taxes, documents, custom fields and client.",
