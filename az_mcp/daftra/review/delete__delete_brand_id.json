{
  "path": "/delete/brand/{id}",
  "method": "delete",
  "operation": {
    "summary": "Delete brand",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Deletes a **brand** by id.\n\nThe brand id is supplied in the path. A brand can only be deleted when it is **not assigned to any product** — attempting to delete a brand that is still referenced by a product returns a `400` explaining which product uses it. Reassign or clear the brand on those products first.\n\nOn success the brand is removed.",
    "tags": [
      "Endpoints/Inventory /Brands"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "The brand id to delete.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "The brand was deleted.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        },
        "headers": {}
      },
      "400": {
        "description": "The brand is in use — it is still assigned to one or more products and cannot be deleted until those products are reassigned. The message names the referencing product (and may include a link to it).",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Missing or invalid access token.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        },
        "headers": {}
      },
      "500": {
        "description": "The delete failed unexpectedly. Currently also returned when the brand id does not exist (see the endpoint notes).",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "delete__delete_brand_id"
  },
