{
  "path": "/stores/{id}{format}",
  "method": "get",
  "operation": {
    "summary": "GET Single Store",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns a single store (warehouse) by its id. Requires the *Track Inventory* permission.",
    "tags": [
      "Endpoints/Inventory /Stores",
      "Stores"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Id of the store to retrieve.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "result": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "Store": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Unique identifier of the store.",
                          "readOnly": true
                        },
                        "name": {
                          "type": "string",
                          "maxLength": 255,
                          "description": "Name of the store."
                        },
                        "shipping_address": {
                          "type": "string",
                          "description": "Shipping address of the store.",
                          "default": null,
                          "nullable": true
                        },
                        "primary": {
                          "type": "integer",
                          "enum": [
                            0,
                            1
                          ],
                          "description": "Whether this is the primary (default) store.\n\n| Value | Meaning |\n|---|---|\n| 0 | Not primary |\n| 1 | Primary |"
                        },
                        "active": {
                          "type": "integer",
                          "enum": [
                            0,
                            1,
                            2
                          ],
                          "description": "Store status.\n\n| Value | Meaning |\n|---|---|\n| 0 | Inactive |\n| 1 | Active |\n| 2 | Suspended |"
                        },
                        "branch_id": {
                          "type": "integer",
                          "description": "Branch the store belongs to."
                        },
                        "created": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the store was created.",
                          "readOnly": true
                        },
                        "modified": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the store was last updated.",
                          "readOnly": true
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "403": {
        "description": "Forbidden — the user lacks the Track Inventory permission.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "404": {
        "description": "Not Found — no store exists with the given id.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "get__stores_id_format"
  },
  "blockers": []
}
