{
  "path": "/invoices/add_subscription{format}",
  "method": "post",
  "operation": {
    "summary": "Create Subscription",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Creates a **subscription** (recurring invoice generator) that issues invoices automatically on a schedule.\n\nThe request body has the same shape as **Add New Invoice** (an `Invoice` object plus optional `InvoiceItem`, `Payment`, `Client`, etc.), with these recurrence fields on the `Invoice` object:\n\n| Field | Meaning |\n|---|---|\n| `name` | **Required.** Subscription name |\n| `subscription_period` | **Required.** Interval count (defaults to 1) |\n| `subscription_unit` | **Required.** Interval unit: `days`, `weeks`, `months`, `years` (defaults to `months`) |\n| `subscription_max_repeat` | Max invoices to generate (empty = unlimited) |\n| `subscription_issue_before` | Days before the next date to issue each invoice |\n| `active` | Whether the generator is active (`0`/`1`) |\n\n`Invoice.client_id` is required. The document type is set to subscription automatically. See **Add New Invoice** for the full reference of the remaining header / item / payment fields and their defaulting.",
    "tags": [
      "Endpoints/Sales /Subsciptions",
      "Invoices"
    ],
    "parameters": [
      {
        "name": "format",
        "in": "path",
        "description": "Response format extension, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "Invoice": {
                "type": "object",
                "description": "Subscription header. Carries the recurrence configuration plus the standard invoice header fields (see Add New Invoice for the full field reference). The document type is set to subscription automatically.",
                "properties": {
                  "client_id": {
                    "type": "integer",
                    "description": "**Required.** The client this subscription bills."
                  },
                  "name": {
                    "type": "string",
                    "description": "**Required.** A name for the subscription."
                  },
                  "subscription_period": {
                    "type": "integer",
                    "description": "**Required.** How many units make up the interval between generated invoices. Defaults to `1` when omitted.",
                    "default": 1
                  },
                  "subscription_unit": {
                    "type": "string",
                    "description": "**Required.** The interval unit. Defaults to `months` when omitted.\n\n| Value | Meaning |\n|---|---|\n| days | Days |\n| weeks | Weeks |\n| months | Months |\n| years | Years |",
                    "enum": [
                      "days",
                      "weeks",
                      "months",
                      "years"
                    ],
                    "default": "months"
                  },
                  "subscription_max_repeat": {
                    "type": "integer",
                    "description": "Maximum number of invoices to generate. Leave empty for unlimited."
                  },
                  "subscription_issue_before": {
                    "type": "integer",
                    "description": "Number of days before the next date to issue each generated invoice."
                  },
                  "active": {
                    "type": "integer",
                    "description": "Whether the generator is active.",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "date": {
                    "type": "string",
                    "description": "Start / first-issue date (YYYY-MM-DD).",
                    "format": "date"
                  },
                  "currency_code": {
                    "type": "string",
                    "description": "Currency code (for example, `USD`). Optional — defaults to the account currency."
                  }
                },
                "required": [
                  "client_id",
                  "name",
                  "subscription_period",
                  "subscription_unit"
                ]
              },
              "InvoiceItem": {
                "type": "array",
                "description": "Line items for each generated invoice. Same shape as Add New Invoice line items.",
                "items": {
                  "type": "object",
                  "properties": {
                    "item": {
                      "type": "string"
                    },
                    "unit_price": {
                      "type": "number"
                    },
                    "quantity": {
                      "type": "number"
                    },
                    "product_id": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            "required": [
              "Invoice"
            ]
          }
        }
      },
      "required": true
    },
    "responses": {
      "202": {
        "description": "The subscription was created.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "id": {
                  "type": "integer",
                  "description": "The new subscription (recurring invoice generator) id."
                },
                "invoice_number": {
                  "type": "string",
                  "description": "The generated number, when applicable."
                }
              },
              "required": [
                "result",
                "code",
                "id"
              ]
            }
          }
        },
        "headers": {}
      },
      "400": {
        "description": "Validation failed, the client is suspended, the required `client_id` is missing, or the currency conflicts with a linked reservation order.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                },
                "error_type": {
                  "type": "string"
                },
                "extra_data": {
                  "type": "array",
                  "items": {}
                },
                "validation_errors": {
                  "type": "object",
                  "description": "Field-level error messages, present when validation fails.",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "properties": {}
                }
              },
              "required": [
                "result",
                "code",
                "message"
              ]
            }
          }
        },
        "headers": {}
      },
      "403": {
        "description": "The authenticated user lacks permission to create invoices.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                },
                "error_type": {
                  "type": "string"
                },
                "extra_data": {
                  "type": "array",
                  "items": {}
                }
              },
              "required": [
                "result",
                "code",
                "message"
              ]
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "post__invoices_add_subscription_format"
  },
  "blockers": []
}
