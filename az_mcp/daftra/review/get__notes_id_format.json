{
  "path": "/notes/{id}{format}",
  "method": "get",
  "operation": {
    "summary": "GET Single Note",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns a single note by its identifier, including the note text, the record it is attached to (`item_type` + `item_id`), the author, any follow-up action/status, and its attached files.",
    "tags": [
      "Endpoints/Clients /Notes",
      "Notes"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Identifier of the note to retrieve.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "Note": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Unique identifier of the note.",
                          "readOnly": true
                        },
                        "item_id": {
                          "type": "integer",
                          "description": "Identifier of the record the note belongs to."
                        },
                        "item_type": {
                          "type": "integer",
                          "enum": [
                            1,
                            2,
                            3,
                            4,
                            5,
                            6,
                            7,
                            8
                          ],
                          "description": "The kind of record the note is attached to.\n\n| Value | Meaning |\n|---|---|\n| 1 | Client |\n| 2 | Invoice |\n| 3 | Estimate |\n| 4 | Purchase invoice |\n| 5 | Staff |\n| 6 | Supplier |\n| 7 | Product |\n| 8 | Work order |"
                        },
                        "date": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Date of the note."
                        },
                        "staff_id": {
                          "type": "integer",
                          "description": "Author staff id, or `0` for the account owner."
                        },
                        "branch_id": {
                          "type": "integer",
                          "description": "Branch the note belongs to.",
                          "nullable": true
                        },
                        "body": {
                          "type": "string",
                          "description": "Note text. May contain HTML.",
                          "nullable": true
                        },
                        "share_with_partner": {
                          "type": "integer",
                          "enum": [
                            0,
                            1
                          ],
                          "description": "Whether the note is shared with the client.\n\n| Value | Meaning |\n|---|---|\n| 0 | Private |\n| 1 | Shared with client |"
                        },
                        "action_id": {
                          "type": "integer",
                          "description": "Follow-up action reference.",
                          "nullable": true
                        },
                        "status_id": {
                          "type": "integer",
                          "description": "Follow-up status reference.",
                          "nullable": true
                        },
                        "created": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the note was created.",
                          "readOnly": true
                        },
                        "modified": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the note was last updated.",
                          "readOnly": true
                        },
                        "NoteAttachment": {
                          "type": "array",
                          "description": "Files attached to the note.",
                          "items": {
                            "type": "object",
                            "properties": {}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
