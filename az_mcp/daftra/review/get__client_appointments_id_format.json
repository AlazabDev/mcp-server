{
  "path": "/client_appointments/{id}{format}",
  "method": "get",
  "operation": {
    "summary": "GET Single Client Appointment",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns a single client appointment by ID.\n\nThe appointment is returned under a `FollowUpReminder` object (the underlying model), together with the IDs of any assigned staff. Returns `404` if no appointment matches the ID. Requires a permission that grants access to clients' notes & appointments.",
    "tags": [
      "Endpoints/Clients /Client Appointments",
      "Client Appointments"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "result": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "FollowUpReminder": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "Unique appointment identifier."
                        },
                        "item_type": {
                          "type": "integer",
                          "enum": [
                            1,
                            2,
                            3,
                            8
                          ],
                          "description": "Type of record the appointment is attached to. Always `1` (Client) for this endpoint.\n\n| Value | Meaning |\n|---|---|\n| 1 | Client |\n| 2 | Invoice |\n| 3 | Estimate |\n| 8 | Work order |"
                        },
                        "item_id": {
                          "type": "integer",
                          "description": "Reference of the record the appointment belongs to (the client ID for client appointments)."
                        },
                        "partner_type": {
                          "type": "integer",
                          "enum": [
                            1
                          ],
                          "description": "Type of the appointment partner.\n\n| Value | Meaning |\n|---|---|\n| 1 | Client |"
                        },
                        "partner_id": {
                          "type": "integer",
                          "description": "Reference of the appointment partner (e.g. the client ID)."
                        },
                        "staff_id": {
                          "type": "integer",
                          "description": "Staff member who created the appointment. `0` means the account owner / system."
                        },
                        "date": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Date and time of the appointment."
                        },
                        "end_date": {
                          "type": "string",
                          "format": "date-time",
                          "description": "End date and time of the appointment, when set.",
                          "nullable": true
                        },
                        "body": {
                          "type": "string",
                          "description": "Free-text body / note for the appointment."
                        },
                        "action_id": {
                          "type": "integer",
                          "description": "Follow-up action to be performed."
                        },
                        "status": {
                          "type": "integer",
                          "enum": [
                            0,
                            1,
                            2
                          ],
                          "description": "Appointment status.\n\n| Value | Meaning |\n|---|---|\n| 0 | Scheduled |\n| 1 | Done |\n| 2 | Dismissed |"
                        },
                        "status_date": {
                          "type": "string",
                          "format": "date-time",
                          "description": "When the status was last changed.",
                          "nullable": true
                        },
                        "post_id": {
                          "type": "integer",
                          "description": "Linked note/post reference (`0` when none)."
                        },
                        "recurring_appointment_id": {
                          "type": "integer",
                          "description": "Reference of the recurring-appointment parent, when this appointment is part of a recurrence.",
                          "nullable": true
                        },
                        "share_with_partner": {
                          "type": "boolean",
                          "description": "Whether the appointment is shared with the partner. `0` / `1`."
                        },
                        "is_waiting": {
                          "type": "boolean",
                          "description": "Whether the appointment is in the waiting state. `0` / `1`."
                        },
                        "branch_id": {
                          "type": "integer",
                          "description": "Branch the appointment is scoped to."
                        },
                        "created": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the appointment was created."
                        },
                        "modified": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the appointment was last updated."
                        },
                        "AssignedStaff": {
                          "type": "object",
                          "properties": {
                            "staff_id": {
                              "type": "array",
                              "items": {
                                "type": "integer"
                              },
                              "description": "IDs of the staff members assigned to this appointment."
                            }
                          },
                          "description": "Staff assigned to the appointment."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
