{
  "path": "/products{format}",
  "method": "post",
  "operation": {
    "summary": "Add New Product",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Creates a new product, service or bundle.\n\nThe request body wraps the product fields in a `Product` object. Only `name` is required — every other field is optional and sensible defaults are applied automatically when omitted (for example `type` defaults to Product, `status` to Active, and the taxes to the account's default product taxes).\n\nFor bundles (`type = 3`), supply the components in a `ProductBundle` array. Requires a permission that grants the right to add products. On success the new product ID is returned with HTTP 202.",
    "tags": [
      "Endpoints/Inventory /Products",
      "Products"
    ],
    "parameters": [
      {
        "name": "format",
        "in": "path",
        "description": "",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "Product": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Required. Product name."
                  },
                  "type": {
                    "type": "integer",
                    "enum": [
                      1,
                      2,
                      3
                    ],
                    "description": "Product type. Defaults to `1` (Product) when omitted.\n\n| Value | Meaning |\n|---|---|\n| 1 | Product |\n| 2 | Service |\n| 3 | Bundle |"
                  },
                  "product_code": {
                    "type": "string",
                    "description": "Product code. Auto-generated when omitted."
                  },
                  "barcode": {
                    "type": "string",
                    "description": "Barcode. Optional, but when provided it must be unique and at least 5 characters long."
                  },
                  "description": {
                    "type": "string",
                    "description": "Product description (up to 100,000 characters)."
                  },
                  "notes": {
                    "type": "string",
                    "description": "Internal notes."
                  },
                  "unit_price": {
                    "type": "number",
                    "description": "Selling price of one unit."
                  },
                  "buy_price": {
                    "type": "number",
                    "description": "Purchase (cost) price."
                  },
                  "minimum_price": {
                    "type": "number",
                    "description": "Minimum selling price."
                  },
                  "profit_margin": {
                    "type": "number",
                    "description": "Profit margin."
                  },
                  "discount": {
                    "type": "number",
                    "description": "Discount amount."
                  },
                  "discount_type": {
                    "type": "integer",
                    "enum": [
                      1,
                      2
                    ],
                    "description": "Discount type.\n\n| Value | Meaning |\n|---|---|\n| 1 | Percentage |\n| 2 | Absolute |"
                  },
                  "tax1": {
                    "type": "integer",
                    "description": "First tax ID. Defaults to the account's default product tax when omitted."
                  },
                  "tax2": {
                    "type": "integer",
                    "description": "Second tax ID. Defaults to the account's second default product tax when omitted."
                  },
                  "supplier_id": {
                    "type": "integer",
                    "description": "Default supplier ID."
                  },
                  "brand": {
                    "type": "string",
                    "description": "Brand name. Created automatically if it does not yet exist."
                  },
                  "category": {
                    "type": "string",
                    "description": "Single category name. Prefer `categories_id` for the API."
                  },
                  "categories_id": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Category IDs to assign to the product."
                  },
                  "tags": {
                    "type": "string",
                    "description": "Tags as a comma-separated string (or an array of strings)."
                  },
                  "status": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2
                    ],
                    "description": "Product status. Defaults to `0` (Active).\n\n| Value | Meaning |\n|---|---|\n| 0 | Active |\n| 1 | Inactive |\n| 2 | Suspended |"
                  },
                  "track_stock": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Whether to track stock for this product. Requires the Inventory feature. Defaults automatically based on what the account sells."
                  },
                  "tracking_type": {
                    "type": "integer",
                    "description": "Stock tracking type. Required when `track_stock` is `1` and the Product Tracking feature is enabled; otherwise defaulted."
                  },
                  "initial_stock_level": {
                    "type": "number",
                    "description": "Opening stock quantity. Applied when `track_stock` is `1` and a `store_id` is provided."
                  },
                  "store_id": {
                    "type": "integer",
                    "description": "Warehouse for the opening stock. Must be an active store."
                  },
                  "low_stock_thershold": {
                    "type": "integer",
                    "description": "Threshold at which a low-stock notification is raised."
                  },
                  "duration_minutes": {
                    "type": "number",
                    "description": "Service duration in minutes (services only)."
                  },
                  "availabe_online": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Whether the product is available online (`1`) or not (`0`)."
                  }
                }
              },
              "ProductBundle": {
                "type": "array",
                "description": "Bundle components — only used when `type` is `3` (Bundle).",
                "items": {
                  "type": "object",
                  "required": [
                    "product_id",
                    "quantity"
                  ],
                  "properties": {
                    "product_id": {
                      "type": "integer",
                      "description": "ID of a product included in the bundle."
                    },
                    "quantity": {
                      "type": "number",
                      "description": "Quantity of that product in the bundle."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "required": true
    },
    "responses": {
      "202": {
        "description": "Product created. Returns the new product ID.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "id": {
                  "type": "integer",
                  "description": "ID of the newly created product."
                }
              }
            }
          }
        },
        "headers": {}
      },
      "400": {
        "description": "Validation failed, a bundle component is invalid, or a duplicate product was detected (`error_type: \"DUPLICATED\"` with the existing product's `id` in `extra_data`).",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string",
                  "nullable": true
                },
                "error_type": {
                  "type": "string",
                  "enum": [
                    "DUPLICATED",
                    null
                  ],
                  "description": "`DUPLICATED` when a matching product already exists; otherwise null.",
                  "nullable": true
                },
                "extra_data": {
                  "type": "object",
                  "description": "For `DUPLICATED`, contains the existing product's `id`.",
                  "properties": {
                    "id": {
                      "type": "integer"
                    }
                  }
                },
                "validation_errors": {
                  "type": "object",
                  "description": "Field-level validation messages, keyed by field name.",
                  "properties": {}
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Missing or invalid access token.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "403": {
        "description": "The authenticated user lacks permission to add products.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "post__products_format"
  },
  "blockers": []
}
