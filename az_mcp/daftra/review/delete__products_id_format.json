{
  "path": "/products/{id}{format}",
  "method": "delete",
  "operation": {
    "summary": "Delete Products",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Deletes a product, service or bundle by its ID.\n\nA product can only be deleted when it has no stock movements and is not tied to a package: if the product has existing stock transactions it cannot be deleted — deactivate it instead. Deleting a product also removes its bundle links and any price-list entries. Products are scoped to the current branch.\n\nOn success the response is a confirmation with HTTP 200.",
    "tags": [
      "Endpoints/Inventory /Products",
      "Products"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Unique identifier of the product to delete.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix appended to the path. Use `.json` for JSON responses.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Product deleted.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string",
                  "description": "Confirmation message. Reads \"Service has been deleted\" when the deleted item is a service."
                }
              }
            }
          }
        },
        "headers": {}
      },
      "400": {
        "description": "The product cannot be deleted: no product ID was supplied, the product is tied to a package, or it fails the deletion eligibility checks.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "401": {
        "description": "Missing or invalid access token.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "403": {
        "description": "The authenticated user lacks permission to delete this product.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "404": {
        "description": "No product matches the given ID, or the product belongs to another branch and is not shared with the current branch.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      },
      "500": {
        "description": "The product has existing stock transactions and cannot be deleted (deactivate it instead), or the deletion otherwise failed.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "headers": {}
      }
    },
    "security": [
      {
        "DaftraConnection": []
      }
    ],
    "operationId": "delete__products_id_format"
  },
  "blockers": []
}
