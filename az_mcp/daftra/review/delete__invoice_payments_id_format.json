{
  "path": "/invoice_payments/{id}{format}",
  "method": "delete",
  "operation": {
    "summary": "Delete Invoice Payments",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Delete an invoice payment by its id.\n\nRemoving the payment re-adjusts the related invoice's paid total and the client's balance, and removes any attachments linked to the payment.\n\n**Access:** requires permission to edit/remove invoice payments — either across all payments, or limited to the caller's own payments. Payments tied to an advance-payment invoice, and (when automatic invoice payment is enabled) client-credit payments, cannot be deleted via the API.",
    "tags": [
      "Endpoints/Sales /Invoice Payments",
      "Invoice Payments"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Numeric reference of the invoice payment to delete.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format suffix appended to the path, e.g. `.json`.",
