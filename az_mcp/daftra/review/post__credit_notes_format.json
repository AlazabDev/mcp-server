{
  "path": "/credit_notes{format}",
  "method": "post",
  "operation": {
    "summary": "Add New Credit Note",
    "deprecated": false,
    "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Creates a new **credit note**.\n\nThe request body has the same shape as **Add New Invoice** (an `Invoice` object plus optional `InvoiceItem`, `Payment`, `Client`, etc.); the document type is set to credit note automatically. As a convenience a `CreditNote` object is also accepted in place of `Invoice`.\n\n`Invoice.client_id` is required. A credit note is typically issued against a source invoice — set `Invoice.subscription_id` to that invoice's id (optional). See **Add New Invoice** for the full reference of the remaining header / item / payment fields and their defaulting.",
    "tags": [
      "Endpoints/Sales /Credit Notes",
      "Credit Notes"
    ],
    "parameters": [
      {
        "name": "format",
        "in": "path",
        "description": "Response format extension, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "Invoice": {
                "type": "object",
                "description": "Credit-note header. Same fields as the Add New Invoice header (a `CreditNote` key is also accepted in place of `Invoice`). The document type is set to credit note automatically.",
                "properties": {
                  "client_id": {
                    "type": "integer",
                    "description": "**Required.** The client this credit note is for."
                  },
                  "subscription_id": {
                    "type": "integer",
                    "description": "Optional. The id of the source invoice this credit note is issued against."
                  },
                  "date": {
                    "type": "string",
                    "description": "Credit-note date (YYYY-MM-DD). Must fall within an open financial period.",
                    "format": "date"
                  },
                  "currency_code": {
                    "type": "string",
                    "description": "Currency code (for example, USD). Optional — defaults to the account currency."
                  },
                  "store_id": {
                    "type": "integer",
                    "description": "Store / warehouse for line items. Optional — defaults to the primary store."
                  },
                  "notes": {
                    "type": "string",
                    "description": "Free-text notes."
                  }
                },
                "required": [
                  "client_id"
                ]
              },
              "InvoiceItem": {
                "type": "array",
                "description": "Credit-note line items. Same shape as Add New Invoice line items.",
                "items": {
                  "type": "object",
                  "properties": {
                    "item": {
                      "type": "string"
                    },
                    "unit_price": {
                      "type": "number"
                    },
                    "quantity": {
                      "type": "number"
                    },
                    "product_id": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            "required": [
              "Invoice"
            ]
          }
        }
      },
      "required": true
    },
    "responses": {
      "202": {
        "description": "The credit note was created.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "id": {
                  "type": "integer",
                  "description": "The new credit note id."
                }
              },
              "required": [
                "result",
                "code",
                "id"
              ]
            }
          }
        },
        "headers": {}
      },
