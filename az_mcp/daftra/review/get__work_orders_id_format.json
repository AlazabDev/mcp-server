{
  "path": "/work_orders/{id}{format}",
  "method": "get",
  "operation": {
    "summary": "GET Single Work Order",
    "deprecated": false,
    "description": "Read operation. Retrieve all required pages before reporting complete totals. Returns a single work order by its identifier.\n\nRequires permission to view the work order. Staff who only hold `View his work orders` may view a work order only if they created it or are assigned to it. The work order is returned under a `data.WorkOrder` key; related records (client, staff, follow-up status) are not embedded.\n\nThis endpoint serves classic work orders; workflow-type entities are handled separately.",
    "tags": [
      "Endpoints/Work Orders/Work Orders",
      "Work Orders"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "The work order identifier.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "format",
        "in": "path",
        "description": "Response format extension, e.g. `.json`.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
