                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "TimeTracking": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "format": "int64",
                                "description": "Unique identifier.",
                                "readOnly": true
                              },
                              "staff_id": {
                                "type": "integer",
                                "format": "int32",
                                "description": "The staff member the time is tracked for. `0` means the site owner. Look staff up via the GET Staff endpoint."
                              },
                              "project_id": {
                                "type": "integer",
                                "format": "int64",
                                "description": "The project this time is tracked against. Look projects up via the GET General Listing endpoint with model `Project`."
                              },
                              "activity_id": {
                                "type": "integer",
                                "format": "int64",
                                "description": "The activity for this entry. Look activities up via the GET General Listing endpoint with model `TimeActivity`."
                              },
                              "date": {
                                "type": "string",
                                "format": "date",
                                "description": "The date the time is tracked on."
                              },
                              "time": {
                                "type": "number",
                                "format": "double",
                                "description": "Tracked time in decimal hours (e.g. `8.5` = 8 hours 30 minutes). Returns `0` when unset. Use `time_formatted` for the `HH:MM` breakdown."
                              },
                              "time_formatted": {
                                "type": "object",
                                "description": "Human-readable breakdown of `time`. Returned on read; ignored on write.",
