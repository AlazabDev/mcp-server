                                  "hours": {
                                    "type": "integer",
                                    "description": "Whole hours."
                                  },
                                  "minutes": {
                                    "type": "integer",
                                    "description": "Minutes past the hour."
                                  },
                                  "seconds": {
                                    "type": "integer",
                                    "description": "Seconds."
                                  },
                                  "string": {
                                    "type": "string",
                                    "description": "Visual `HH:MM` representation."
                                  }
                                },
                                "readOnly": true
                              },
