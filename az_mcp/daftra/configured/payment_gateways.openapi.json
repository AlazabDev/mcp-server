                              },
                              "modified": {
                                "type": "string",
                                "nullable": true
                              },
                              "currency_code": {
                                "type": "string",
                                "nullable": true
                              },
                              "metainfo": {
                                "type": "string",
                                "nullable": true
                              }
                            },
                            "nullable": true
                          },
                          "branch": {
                            "type": "object",
                            "description": "The branch this payment method belongs to.",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              },
                              "status": {
                                "type": "integer",
                                "nullable": true
                              },
                              "created": {
                                "type": "string",
                                "nullable": true
                              },
                              "modified": {
                                "type": "string",
                                "nullable": true
                              },
                              "code": {
                                "type": "string",
                                "nullable": true
                              }
                            }
                          }
                        }
                      }
                    },
                    "per_page": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "last_page": {
                      "type": "integer"
                    },
                    "from": {
                      "type": "integer",
                      "nullable": true
                    },
                    "to": {
                      "type": "integer",
                      "nullable": true
                    },
                    "first_page_url": {
                      "type": "string"
                    },
                    "last_page_url": {
                      "type": "string"
                    },
                    "next_page_url": {
                      "type": "string",
                      "nullable": true
                    },
                    "prev_page_url": {
                      "type": "string",
