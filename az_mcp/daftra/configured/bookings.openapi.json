          }
        },
        "security": [
          {
            "DaftraConnection": []
          }
        ],
        "operationId": "delete__bookings_bookingId"
      }
    },
    "/bookings/change_status/{bookingId}/{bookingStatus}": {
      "get": {
        "summary": "Change Booking Status",
        "deprecated": false,
        "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Changes the status of a booking. Pass the booking id and the target status code in the path.\n\n| Value | Status |\n|---|---|\n| 0 | Pending |\n| 1 | Confirmed |\n| 2 | Invoiced (set automatically when the booking is converted to an invoice) |\n| 3 | Cancelled |\n| 4 | Done |\n\nTypically you set `1` (Confirmed), `3` (Cancelled), or `4` (Done). The request always responds with HTTP 200 carrying an `error` flag: `error` is `false` when the status was changed, and `true` when it was not (for example an unsupported status, or a booking already converted to an invoice). A booking id that does not exist returns 404.\n\nThe `.json` extension is optional.",
        "tags": [
          "Endpoints/Bookings/Booking (Classic version)"
        ],
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "description": "The id of the booking whose status is being changed.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bookingStatus",
            "in": "path",
            "description": "Target status code. `0` Pending · `1` Confirmed · `2` Invoiced · `3` Cancelled · `4` Done.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Always returned (HTTP 200) whether or not the change applied — check the `error` flag. Success: `{\"message\":\"Status Changed Successfully\",\"error\":false}`. Not applied: `{\"message\":\"\",\"error\":true}`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Result message. Empty when the change was not applied."
                    },
                    "error": {
                      "type": "boolean",
                      "description": "`false` when the status was changed; `true` when it was not applied (unsupported status, or booking already converted)."
                    }
                  },
                  "required": [
                    "message",
                    "error"
                  ]
                }
              }
            },
            "headers": {}
          },
          "404": {
            "description": "No booking exists with the given id.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string"
                    },
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error_type": {
                      "nullable": true,
                      "enum": [
                        null
                      ]
                    },
                    "extra_data": {
                      "nullable": true,
                      "enum": [
                        null
                      ]
                    }
                  },
                  "required": [
                    "result",
                    "code",
                    "message"
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "DaftraConnection": []
          }
        ],
        "operationId": "get__bookings_change_status_bookingId_bookingStatus"
      }
    },
    "/bookings/convert_to_invoice/{bookingId}": {
      "get": {
        "summary": "Convert booking to Invoice",
        "deprecated": false,
        "description": "MUTATING operation. Verify target and authorized intent; reconcile outcome before retry. Converts a booking into an invoice. On success it returns the id of the newly created invoice and marks the booking as *Invoiced*.\n\nThe conversion is rejected when the booking is cancelled, already converted, or missing required data. A booking id that does not exist returns 404.\n\nThe `.json` extension is optional.",
        "tags": [
          "Endpoints/Bookings/Booking (Classic version)"
        ],
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "description": "The id of the booking to convert.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "The booking was converted. Returns HTTP 202 with the new invoice id.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string"
                    },
                    "code": {
                      "type": "integer"
                    },
                    "id": {
                      "type": "string",
                      "description": "The id of the invoice created from the booking."
                    }
                  },
                  "required": [
                    "result",
                    "code",
                    "id"
                  ]
                }
              }
            },
            "headers": {}
          },
          "400": {
            "description": "The booking could not be converted — it is cancelled, already converted, or missing required data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string"
                    },
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error_type": {
                      "type": "string"
                    },
                    "extra_data": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "result",
                    "code",
                    "message"
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "DaftraConnection": []
          }
        ],
        "operationId": "get__bookings_convert_to_invoice_bookingId"
      }
    }
