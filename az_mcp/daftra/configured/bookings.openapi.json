                    },
                    "message": {
                      "type": "string"
                    },
                    "error_type": {
                      "nullable": true,
                      "enum": [
                        null
                      ]
                    },
                    "extra_data": {
                      "nullable": true,
                      "enum": [
                        null
                      ]
                    }
                  },
                  "required": [
                    "result",
                    "code",
                    "message"
                  ]
                }
              }
            },
