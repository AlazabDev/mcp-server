    "/follow_up_status/list/{dataLevel}": {
      "get": {
        "summary": "Get All Follow-Up Statuses",
        "deprecated": false,
        "description": "Read operation. Retrieve all required pages before reporting complete totals. Lists follow-up statuses for the account.\n\nThis is a v2 native-entity endpoint served from the `/v2/api/entity` base and authenticated with a Bearer token. The response is a paginated collection (20 per page by default).\n\n- **Pagination:** use `?page=<n>`. The response carries `current_page`, `last_page`, `per_page`, and `total`.\n- **Filtering:** `filter[<field>][<operator>]=<value>` (for example `filter[status][equal]=1`). Any existing column can be filtered.\n- **Sorting:** `sort[<field>]=asc|desc` (for example `sort[id]=desc`). When no `sort` is given the default order is `id` descending.\n\nThe `{dataLevel}` path segment selects the listing data level (use `1`).",
        "tags": [
          "Endpoints/Follow-Up Statuses",
          "Follow Up Statuses"
        ],
        "parameters": [
          {
            "name": "dataLevel",
            "in": "path",
            "description": "Listing data level. Use `1`.",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination (default `1`).",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "filter[status][equal]",
            "in": "query",
            "description": "Example filter. General form: `filter[<field>][<operator>]=<value>`. Filters on any existing column.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort[id]",
            "in": "query",
            "description": "Example sort. General form: `sort[<field>]=asc|desc`. Default order is `id` descending.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of follow-up statuses.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "current_page": {
                      "type": "integer",
                      "description": "The current page number."
                    },
                    "data": {
                      "type": "array",
                      "description": "The follow-up statuses on this page.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "description": "Status id."
                          },
                          "item_type": {
                            "type": "integer",
                            "description": "Module/record type the status applies to (see the create endpoint)."
                          },
                          "name": {
                            "type": "string",
                            "description": "Status name."
                          },
                          "color": {
                            "type": "string",
                            "description": "Display color (hex), empty string if unset."
                          },
                          "status": {
                            "type": "integer",
                            "description": "Stage: `1` = Open, `2` = Closed."
                          },
                          "staff_id": {
                            "type": "integer",
                            "description": "Id of the owning staff member."
                          },
                          "created": {
                            "type": "string",
                            "description": "Creation timestamp."
                          },
                          "modified": {
                            "type": "string",
                            "description": "Last-modified timestamp."
                          },
                          "deleted": {
                            "type": "integer",
                            "description": "Soft-delete flag (`0`/`1`)."
                          },
                          "entity_key": {
                            "type": "string",
                            "description": "Linked entity key, if any.",
                            "nullable": true
                          },
                          "display_order": {
                            "type": "integer",
                            "description": "Display order.",
                            "nullable": true
                          }
                        }
                      }
                    },
                    "first_page_url": {
                      "type": "string",
                      "description": "URL of the first page.",
                      "nullable": true
                    },
                    "from": {
                      "type": "integer",
                      "description": "Index of the first row on this page.",
                      "nullable": true
                    },
                    "last_page": {
                      "type": "integer",
                      "description": "Number of the last page."
                    },
                    "last_page_url": {
                      "type": "string",
                      "description": "URL of the last page.",
                      "nullable": true
                    },
                    "next_page_url": {
                      "type": "string",
                      "description": "URL of the next page (null on the last page).",
                      "nullable": true
                    },
                    "path": {
                      "type": "string",
                      "description": "Base path of the list."
                    },
                    "per_page": {
                      "type": "integer",
                      "description": "Rows per page (default 20)."
                    },
                    "prev_page_url": {
                      "type": "string",
                      "description": "URL of the previous page (null on the first page).",
                      "nullable": true
                    },
                    "to": {
                      "type": "integer",
                      "description": "Index of the last row on this page.",
                      "nullable": true
                    },
                    "total": {
                      "type": "integer",
                      "description": "Total number of matching rows."
                    }
                  }
                }
              }
            },
            "headers": {}
          },
          "401": {
            "description": "Missing or invalid Bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "headers": {}
          }
        },
