{
  "openapi": "3.0.1",
  "info": {
    "title": "Alazab Daftra Purchases Read Tools",
    "version": "1.0.0",
    "description": "Evidence-gated live-verified read endpoints."
  },
  "servers": [
    {
      "url": "https://alazab-co.daftra.com/api2"
    }
  ],
  "paths": {
    "/purchase_invoices.json": {
      "get": {
        "summary": "GET All Purchase Invoices",
        "description": "Live-read verified Daftra collection endpoint for purchase_invoices. Use identifiers from collection responses for detail lookups.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 20
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; actual response samples are stored in evidence files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "operationId": "get_purchase_invoices_list"
      }
    },
