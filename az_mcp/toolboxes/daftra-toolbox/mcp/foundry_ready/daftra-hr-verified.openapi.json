{
  "openapi": "3.0.1",
  "info": {
    "title": "Alazab Daftra Hr Read Tools",
    "version": "1.0.0",
    "description": "Evidence-gated live-verified read endpoints."
  },
  "servers": [
    {
      "url": "https://alazab-co.daftra.com/api2"
    }
  ],
  "paths": {
    "/staff.json": {
      "get": {
        "summary": "GET All Staff",
        "description": "Live-read verified Daftra collection endpoint for staff. Use identifiers from collection responses for detail lookups.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; actual response samples are stored in evidence files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "operationId": "get_staff_list"
      }
    },
    "/time_tracking.json": {
      "get": {
        "summary": "GET All Time Tracking",
        "description": "Live-read verified Daftra collection endpoint for time_tracking. Use identifiers from collection responses for detail lookups.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 20
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; actual response samples are stored in evidence files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "operationId": "get_time_tracking_list"
      }
    },
    "/staff/{id}.json": {
      "get": {
        "summary": "GET Single Staff",
        "description": "Live-read verified Daftra detail endpoint for staff. Use identifiers from collection responses for detail lookups.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; actual response samples are stored in evidence files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "operationId": "get_staff_by_id"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DaftraApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey"
      }
    }
  },
  "security": [
    {
      "DaftraApiKey": []
    }
  ]
}
