{
  "openapi": "3.1.0",
  "info": {
    "title": "Alazab Meta WhatsApp — Messaging",
    "version": "1.0.0",
    "description": "Foundry-friendly OpenAPI for core WhatsApp Cloud API messaging and media operations. Graph version is an explicit path parameter so the spec does not hard-code a Meta Graph API version."
  },
  "servers": [
    {
      "url": "https://graph.facebook.com"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/{graph_version}/{phone_number_id}/messages": {
      "post": {
        "operationId": "sendWhatsAppMessage",
        "summary": "Send a WhatsApp message",
        "parameters": [
          {
            "$ref": "#/components/parameters/GraphVersion"
          },
          {
            "$ref": "#/components/parameters/PhoneNumberId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Meta Graph API error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/{graph_version}/{phone_number_id}/media": {
      "post": {
        "operationId": "uploadWhatsAppMedia",
        "summary": "Upload media for WhatsApp messaging",
        "parameters": [
          {
            "$ref": "#/components/parameters/GraphVersion"
          },
          {
            "$ref": "#/components/parameters/PhoneNumberId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "messaging_product",
                  "file"
                ],
                "properties": {
                  "messaging_product": {
                    "type": "string",
                    "const": "whatsapp"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "type": {
                    "type": "string",
                    "description": "Optional MIME type when required by client/tooling."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded media",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Meta Graph API error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/{graph_version}/{media_id}": {
      "get": {
        "operationId": "getWhatsAppMediaMetadata",
        "summary": "Get media metadata and download URL",
        "parameters": [
          {
            "$ref": "#/components/parameters/GraphVersion"
          },
          {
            "name": "media_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Media metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Meta Graph API error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteWhatsAppMedia",
        "summary": "Delete uploaded media",
        "parameters": [
          {
            "$ref": "#/components/parameters/GraphVersion"
          },
          {
            "name": "media_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Meta Graph API error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Meta Access Token",
        "description": "Meta Graph API access token. Do not embed tokens in the OpenAPI document."
      }
    },
    "parameters": {
      "GraphVersion": {
        "name": "graph_version",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+$"
        },
        "description": "Meta Graph API version, for example v21.0. Supply the version enabled for your application."
      },
      "PhoneNumberId": {
        "name": "phone_number_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "WhatsApp Business phone number ID."
      }
    },
    "schemas": {
      "MessageRequest": {
        "type": "object",
        "required": [
          "messaging_product",
          "to",
          "type"
        ],
        "properties": {
          "messaging_product": {
            "type": "string",
            "const": "whatsapp"
          },
          "recipient_type": {
            "type": "string",
            "default": "individual"
          },
          "to": {
            "type": "string",
            "description": "Recipient WhatsApp phone number in international format."
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "template",
              "image",
              "video",
              "audio",
              "document",
              "sticker",
              "location",
              "contacts",
              "reaction",
              "interactive"
            ]
          },
          "text": {
            "type": "object",
            "additionalProperties": true
          },
          "template": {
            "type": "object",
            "additionalProperties": true
          },
          "image": {
            "type": "object",
            "additionalProperties": true
          },
          "video": {
            "type": "object",
            "additionalProperties": true
          },
          "audio": {
            "type": "object",
            "additionalProperties": true
          },
          "document": {
            "type": "object",
            "additionalProperties": true
          },
          "sticker": {
            "type": "object",
            "additionalProperties": true
          },
          "location": {
            "type": "object",
            "additionalProperties": true
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "reaction": {
            "type": "object",
            "additionalProperties": true
          },
          "interactive": {
            "type": "object",
            "additionalProperties": true
          },
          "context": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}